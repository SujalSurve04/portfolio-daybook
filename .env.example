# Copy this file to `.env` and fill in real values there.
# `.env` is already listed in .gitignore — it will never be committed.
# This `.env.example` file has no secrets in it and is safe to commit.

# --- Required by scripts/fetch_holdings.py (local testing only) ---
# Get these from groww.in/trade-api/api-keys (generate a TOTP-type key,
# once per Groww account). Run: python scripts/fetch_holdings.py <account>

# Account 1 — sujal
GROWW_API_KEY_SUJAL=
GROWW_TOTP_SECRET_SUJAL=

# Account 2 — manali
GROWW_API_KEY_MANALI=
GROWW_TOTP_SECRET_MANALI=

# --- Only used by the GitHub Actions workflow (daily-strategy.yml), ---
# --- not read by any script in this repo. Listed here for reference ---
# --- only — set these as GitHub repo secrets, not in this file.     ---
# ANTHROPIC_API_KEY=
# CLAUDE_CODE_OAUTH_TOKEN=
